{
  "name": "yt-factory 5 backup workflows to GitHub",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 3
            }
          ]
        }
      },
      "id": "daily-03-00",
      "name": "Daily 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {}
      },
      "id": "get-workflows",
      "name": "Get all workflows",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        220,
        300
      ],
      "credentials": {
        "n8nApi": {
          "id": "6",
          "name": "n8n API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// EDIT these two values after import\nconst REPO = 'YOUR_GITHUB_USER/yt-factory';\nconst OWNER_CHAT = 'YOUR_TELEGRAM_CHAT_ID';\nconst all = $input.all().map((i) => i.json);\nconst content = Buffer.from(JSON.stringify(all, null, 1), 'utf8').toString('base64');\nreturn [{ json: { content, count: all.length, repo: REPO } }];"
      },
      "id": "bundle",
      "name": "Bundle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/contents/n8n/backup/workflows.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "existing-file",
      "name": "Existing file",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "GitHub PAT"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const b = $('Bundle').item.json;\nconst body = { message: 'n8n backup: ' + b.count + ' workflows', content: b.content };\nif ($json.sha) body.sha = $json.sha;\nreturn [{ json: { repo: b.repo, body: JSON.stringify(body) } }];"
      },
      "id": "prepare-put",
      "name": "Prepare PUT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/contents/n8n/backup/workflows.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}"
      },
      "id": "write-backup",
      "name": "Write backup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "GitHub PAT"
        }
      }
    }
  ],
  "connections": {
    "Daily 03:00": {
      "main": [
        [
          {
            "node": "Get all workflows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get all workflows": {
      "main": [
        [
          {
            "node": "Bundle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bundle": {
      "main": [
        [
          {
            "node": "Existing file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Existing file": {
      "main": [
        [
          {
            "node": "Prepare PUT",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare PUT": {
      "main": [
        [
          {
            "node": "Write backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}