      "id": "trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        400
      ],
      "webhookId": "yt-factory-approval",
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram yt-factory"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// EDIT these two values after import\nconst REPO = 'YOUR_GITHUB_USER/yt-factory';\nconst OWNER_CHAT = 'YOUR_TELEGRAM_CHAT_ID';\nconst u = $json;\nif (u.callback_query) {\n  const cb = u.callback_query;\n  if (String(cb.message.chat.id) !== OWNER_CHAT) return [];\n  const [action, tid] = (cb.data || '').split(':');\n  return [{ json: { kind: 'button', action, tid, repo: REPO, chat_id: cb.message.chat.id,\n    callback_id: cb.id, file_id: (cb.message.video && cb.message.video.file_id) || '' } }];\n}\nconst msg = u.message || {};\nif (!msg.chat || String(msg.chat.id) !== OWNER_CHAT) return [];\nconst m = (msg.text || '').match(/^\\/(pause|resume)\\s+(\\w+)/i);\nif (m) return [{ json: { kind: 'command', action: m[1].toLowerCase(), channel: m[2].toLowerCase(),\n  repo: REPO, chat_id: msg.chat.id } }];\nreturn [];"
      },
      "id": "parse",
      "name": "Parse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        400
      ]
    },
