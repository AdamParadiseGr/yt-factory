    {
      "parameters": {
        "jsCode": "const p = $('Update status').item.json;\nconst saved = $('Save status').item.json;\nconst status = JSON.parse(Buffer.from(p.content, 'base64').toString('utf8'));\nconst drive_url = $json.id ? 'https://drive.google.com/file/d/' + $json.id + '/view' : '';\nif (drive_url) status[p.tid].drive_url = drive_url;\nconst content = Buffer.from(JSON.stringify(status, null, 1), 'utf8').toString('base64');\nreturn [{ json: { drive_url, content, sha: (saved.content && saved.content.sha) || p.sha } }];"
      },
