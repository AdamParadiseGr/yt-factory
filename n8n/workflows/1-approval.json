    {
      "parameters": {
        "jsCode": "const p = $('Update status').item.json;\nlet text = 'Статус: ' + p.label + ' - ' + p.title;\nif (p.action === 'retitle') {\n  try { text = $('Format titles').first().json.text; } catch (e) {}\n}\nif (p.action === 'approve') {\n  let url = '';\n  try { url = $('Add Drive link').first().json.drive_url; } catch (e) {}\n  text += url ? '\\nDrive: ' + url : '\\n(в Drive не сохранено: файл остаётся в Telegram и в артефактах запуска)';\n}\nreturn [{ json: { text } }];"
      },
