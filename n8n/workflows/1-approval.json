    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: 'Give 3 alternative YouTube Shorts titles (max 70 chars, intriguing, no clickbait lies) for this video title: ' + $json.title + '. Return JSON: {\"titles\": [..]}' }] }], generationConfig: { responseMimeType: 'application/json', temperature: 1 } }) }}"
      },
      "id": "ask-gemini",
      "name": "Ask Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        380
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3",
          "name": "Gemini key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const p = $('Update status').item.json;\nlet titles = [];\ntry { titles = JSON.parse($json.candidates[0].content.parts[0].text).titles; } catch (e) {}\nreturn [{ json: { ...p, text: titles.length ? 'Варианты заголовка для \"' + p.title + '\":\\n- ' + titles.join('\\n- ')\n  : 'Не удалось получить варианты, попробуйте ещё раз.' } }];"
      },
      "id": "format-titles",
      "name": "Format titles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        380
      ]
    },
    {
